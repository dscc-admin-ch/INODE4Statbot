env:
  - name: PGUSER
    valueFrom:
      secretKeyRef:
        name: postgresql-credentials
        key: username

  - name: PGPASSWORD
    valueFrom:
      secretKeyRef:
        name: postgresql-credentials
        key: password

  - name: S3_ENDPOINT
    value: "https://s3.example.com"

  - name: S3_ACCESS_KEY
    valueFrom:
      secretKeyRef:
        name: s3-credentials
        key: access-key

  - name: S3_SECRET_KEY
    valueFrom:
      secretKeyRef:
        name: s3-credentials
        key: secret-key